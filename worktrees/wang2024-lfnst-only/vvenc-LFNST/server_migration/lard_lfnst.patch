+double IntraSearch::xLardLfnstClipD( double minVal, double maxVal, double val ) const
+{
+  return val < minVal ? minVal : ( val > maxVal ? maxVal : val );
+}
+
+double IntraSearch::xLardLfnstAbsLatitudeRad( const CodingUnit& cu ) const
+{
+  const double picH = std::max( 1.0, (double)m_pcEncCfg->m_SourceHeight );
+  const double cy = (double)cu.Y().y + 0.5 * (double)cu.Y().height;
+  const double yNorm = xLardLfnstClipD( 0.0, 1.0, cy / picH );
+  const double theta = ( 0.5 - yNorm ) * M_PI;
+  return std::fabs( theta );
+}
+
+double IntraSearch::xLardLfnstQStepApprox( const CodingUnit& cu ) const
+{
+  const int qp = std::max( 0, std::min( 63, (int)cu.qp ) );
+  return std::pow( 2.0, ( (double)qp - 4.0 ) / 6.0 );
+}
+
+double IntraSearch::xLardLfnstThetaSkipRad( const CodingUnit& cu ) const
+{
+  const int qp = std::max( 0, std::min( 63, (int)cu.qp ) );
+  const double qpNorm = xLardLfnstClipD( 0.0, 1.0, ( (double)qp - 22.0 ) / 20.0 );
+
+  double thetaDeg = m_pcEncCfg->m_LardLfnstThetaBaseDeg
+                  - m_pcEncCfg->m_LardLfnstThetaQpSlopeDeg * qpNorm;
+
+  if( m_pcEncCfg->m_LardLfnstSkip >= 2 )
+  {
+    thetaDeg -= 5.0;
+  }
+
+  thetaDeg = xLardLfnstClipD( 35.0, 80.0, thetaDeg );
+  return thetaDeg * M_PI / 180.0;
+}
+
+double IntraSearch::xLardLfnstPredNz( const CodingUnit& cu, const PelUnitBuf& predBuf, double absThetaRad, double& horzRatio, double& meanAbsQ ) const
+{
+  const CPelBuf org  = cu.cs->getOrgBuf( COMP_Y );
+  const CPelBuf pred = predBuf.Y();
+  const int w = (int)cu.Y().width;
+  const int h = (int)cu.Y().height;
+
+  if( w <= 0 || h <= 0 || org.buf == nullptr || pred.buf == nullptr )
+  {
+    horzRatio = 1.0;
+    meanAbsQ  = 999.0;
+    return 999.0;
+  }
+
+  const int stepX = ( w >= 32 ) ? 2 : 1;
+  const int stepY = ( h >= 32 ) ? 2 : 1;
+
+  double sumAbs = 0.0;
+  double sumH   = 0.0;
+  double sumV   = 0.0;
+  int    cnt    = 0;
+
+  for( int y = 0; y < h; y += stepY )
+  {
+    const Pel* orgLine  = org.buf  + y * org.stride;
+    const Pel* predLine = pred.buf + y * pred.stride;
+
+    const Pel* orgLinePrev  = ( y >= stepY ) ? ( org.buf  + ( y - stepY ) * org.stride  ) : nullptr;
+    const Pel* predLinePrev = ( y >= stepY ) ? ( pred.buf + ( y - stepY ) * pred.stride ) : nullptr;
+
+    int prevRes = 0;
+
+    for( int x = 0; x < w; x += stepX )
+    {
+      const int curRes = (int)orgLine[x] - (int)predLine[x];
+      sumAbs += std::fabs( (double)curRes );
+
+      if( x >= stepX )
+      {
+        sumH += std::fabs( (double)( curRes - prevRes ) );
+      }
+
+      if( orgLinePrev && predLinePrev )
+      {
+        const int upRes = (int)orgLinePrev[x] - (int)predLinePrev[x];
+        sumV += std::fabs( (double)( curRes - upRes ) );
+      }
+
+      prevRes = curRes;
+      cnt++;
+    }
+  }
+
+  if( cnt <= 0 )
+  {
+    horzRatio = 1.0;
+    meanAbsQ  = 999.0;
+    return 999.0;
+  }
+
+  const double qStep = std::max( 1e-6, xLardLfnstQStepApprox( cu ) );
+  const double meanAbs = sumAbs / (double)cnt;
+
+  meanAbsQ  = meanAbs / qStep;
+  horzRatio = sumH / ( sumH + sumV + 1e-9 );
+
+  const int roiSize = ( w >= 8 && h >= 8 ) ? 48 : 16;
+  const double b = std::max( 1e-6, meanAbs );
+  const double tanTheta = std::tan( std::min( absThetaRad, 1.45 ) );
+  const double psi = std::max( 0.0, m_pcEncCfg->m_LardLfnstPsi );
+  const double activityGuard = xLardLfnstClipD( 0.25, 1.0, 1.0 - 0.5 * horzRatio );
+  const double latDecay = std::exp( -psi * tanTheta * tanTheta * activityGuard );
+  const double bEff = std::max( 1e-6, b * std::sqrt( latDecay ) );
+  const double tq = 0.65 * qStep;
+  const double pNz = std::exp( -tq / bEff );
+  return (double)roiSize * xLardLfnstClipD( 0.0, 1.0, pNz );
+}
+
+bool IntraSearch::xLardLfnstShouldSkip( const CodingUnit& cu, const PelUnitBuf& predBuf ) const
+{
+  if( !m_pcEncCfg || m_pcEncCfg->m_LardLfnstSkip <= 0 )
+  {
+    return false;
+  }
+
+  if( !cu.cs || !cu.cs->sps || !cu.cs->sps->LFNST )
+  {
+    return false;
+  }
+
+  if( cu.bdpcmM[CH_L] != 0 )
+  {
+    return false;
+  }
+
+  if( cu.ispMode || cu.mipFlag || cu.multiRefIdx )
+  {
+    return false;
+  }
+
+  if( cu.Y().width < 4 || cu.Y().height < 4 )
+  {
+    return false;
+  }
+
+  const double absTheta = xLardLfnstAbsLatitudeRad( cu );
+  const double thetaThr = xLardLfnstThetaSkipRad( cu );
+
+  if( absTheta < thetaThr )
+  {
+    return false;
+  }
+
+  double horzRatio = 1.0;
+  double meanAbsQ  = 999.0;
+  const double predNz = xLardLfnstPredNz( cu, predBuf, absTheta, horzRatio, meanAbsQ );
+
+  double nzThr       = m_pcEncCfg->m_LardLfnstNzThr;
+  double meanAbsQThr = m_pcEncCfg->m_LardLfnstMeanAbsQThr;
+  double horzThr     = m_pcEncCfg->m_LardLfnstMaxHorzRatio;
+
+  if( m_pcEncCfg->m_LardLfnstSkip >= 2 )
+  {
+    nzThr       += 1.5;
+    meanAbsQThr += 0.35;
+    horzThr     += 0.05;
+  }
+
+  return ( predNz <= nzThr )
+      && ( meanAbsQ <= meanAbsQThr )
+      && ( horzRatio <= horzThr );
+}
